    "react": "18.3.1",
    "react-dom": "18.3.1",
    "shiki": "4.3.1",
    "simple-icons": "16.31.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "zustand": "4.4.7"
  }
